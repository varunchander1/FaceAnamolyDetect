# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Everything here is optional except OPENAI_API_KEY; the defaults shown are
# what `vision/settings.py` uses when a variable is absent.

# Scene descriptions call OpenAI. Face detection, identity and alerts are
# fully local and work without this.
OPENAI_API_KEY="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"

# Any OpenAI model with image input.
#   gpt-5-mini    $0.25/$2.00 per 1M — cheapest with vision (default)
#   gpt-5.4-mini  $0.75/$4.50 per 1M — newer, ~3x the running cost
VLM_MODEL=gpt-5-mini

# Comma-separated models tried in order when an answer comes back empty.
VLM_FALLBACK=gpt-5-mini

# Enrolled face embeddings, written by the Train dialog / `make gallery`.
GALLERY_PATH=gallery.npz

# Reference photos, one folder per person.
FACES_DIR=faces
